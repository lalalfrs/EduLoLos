# Neon PostgreSQL connection. Use the full value from NEON_POSTGRES_URL.
DATABASE_URL=
NEON_POSTGRES_URL=
API_PORT=4000
APP_ORIGIN=http://localhost:3000
# Leave VITE_API_URL empty in production so the frontend uses same-origin /api routes.
VITE_API_URL=http://localhost:4000

# Optional Gemini key for AI features
GEMINI_API_KEY=
